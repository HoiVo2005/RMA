NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=replace-with-a-long-random-string

# Domain thật của website — dùng để tạo link chia sẻ (Facebook/X/Zalo) chính xác
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.vercel.app

# Chọn một dịch vụ AI để dịch tin (bắt buộc để có bản dịch tiếng Việt chất lượng):
OPENAI_API_KEY=
# hoặc dùng Groq (miễn phí, nhanh):
# GROQ_API_KEY=
AI_MODEL=gpt-4.1-mini

# Đồng bộ Đội hình & Lịch thi đấu (TheSportsDB — miễn phí):
# Để trống sẽ dùng key test công khai "123" (giới hạn thấp) và ID Real Madrid có sẵn.
# Đăng ký free tại thesportsdb.com để có key riêng ổn định hơn cho tỷ số/lịch thi đấu/logo.
# LƯU Ý: diễn biến trận đấu (ai ghi bàn, kiến tạo, thẻ phạt, thay người — endpoint lookuptimeline.php)
# dùng key test/free thường trả dữ liệu mẫu/không khớp trận thật (TheSportsDB cần gói Patreon $9/tháng
# mới có dữ liệu đúng theo từng trận). Hệ thống đã tự lọc bớt tên giữ chỗ rõ ràng sai, nhưng khuyên dùng
# API-Football bên dưới (miễn phí thật, không cần trả phí) làm nguồn chính cho phần này.
THESPORTSDB_API_KEY=123
THESPORTSDB_TEAM_ID=133738

# Diễn biến trận đấu CHÍNH XÁC (API-Football / api-sports.io — MIỄN PHÍ THẬT, 100 request/ngày,
# không cần thẻ tín dụng, trả dữ liệu thật theo từng trận — ai ghi bàn, kiến tạo, thẻ phạt, thay người):
# 1. Đăng ký free tại https://dashboard.api-football.com/register
# 2. Vào "My Access" lấy API key, điền vào API_FOOTBALL_KEY.
# 3. Lấy TEAM ID của Real Madrid: gọi (dán link vào trình duyệt kèm header, hoặc dùng Live Tester
#    trên dashboard) https://v3.football.api-sports.io/teams?name=Real Madrid — lấy response.team.id
#    điền vào API_FOOTBALL_TEAM_ID bên dưới.
# Để trống thì hệ thống tự dùng TheSportsDB dự phòng (kém chính xác hơn) — không lỗi trang.
API_FOOTBALL_KEY=8e25c08e26adb976c79977df89cd6250
API_FOOTBALL_TEAM_ID=541
# Đồng bộ ĐỘI HÌNH RA SÂN THẬT (Highlightly — miễn phí 100 request/ngày):
# 1. Đăng ký tại https://highlightly.net (hoặc qua RapidAPI) để lấy API key.
# 2. Lấy TEAM ID của Real Madrid bằng lệnh:
#      curl -H "x-rapidapi-key: <API_KEY>" "https://soccer.highlightly.net/teams?name=Real%20Madrid"
#    rồi điền "id" trong kết quả vào HIGHLIGHTLY_TEAM_ID bên dưới.
# 3. GitHub Action "sync-lineup.yml" sẽ tự gọi /api/cron/sync-lineup mỗi 10 phút —
#    đội hình chính thức được lấy ngay khi 2 đội công bố (thường 20-40' trước giờ đấu).
# Để trống thì tính năng tự động vẫn không lỗi trang, chỉ đơn giản là không tự cập nhật
# (admin vẫn xếp đội hình tay được như bình thường ở trang quản trị).
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_TEAM_ID=

# Thông báo đẩy (PWA push notifications) — tạo cặp khoá VAPID bằng lệnh:
#   npx web-push generate-vapid-keys
# Dán khoá public vào NEXT_PUBLIC_VAPID_PUBLIC_KEY, khoá private vào VAPID_PRIVATE_KEY.
# Nếu để trống, site vẫn chạy bình thường — chỉ tính năng "Bật thông báo đẩy" sẽ ẩn/không hoạt động.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
